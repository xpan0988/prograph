@@ -0,0 +1,20 @@
+/** Input visibility is the transitive ancestor set, in the existing execution
+ * order. A projection can leave the cache once its last consumer has copied its
+ * references into an independent input container. This never releases facts.
+ * Call only after orderPasses has validated and ordered the DAG.
+ */
+export function projectionLifetimes(ordered: ReadonlyArray<{ id: string; dependencies: string[] }>) {
+  const ancestors = new Map<string, string[]>();
+  const lastConsumer = new Map<string, string>();
+  for (const pass of ordered) {
+    const visible = new Set<string>();
+    for (const dependency of pass.dependencies) {
+      visible.add(dependency);
+      for (const ancestor of ancestors.get(dependency)!) visible.add(ancestor);
+    }
+    const inputs = ordered.filter(candidate => visible.has(candidate.id)).map(candidate => candidate.id);
+    ancestors.set(pass.id, inputs);
+    for (const id of inputs) lastConsumer.set(id, pass.id);
+  }
+  return { ancestors, lastConsumer };
+}
